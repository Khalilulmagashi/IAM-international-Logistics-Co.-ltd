PORT=3000

# SMTP configuration for Nodemailer
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Where contact form messages should be sent
CONTACT_TO_EMAIL=Ibrahimmagash2468.com
CONTACT_FROM_EMAIL=website@your-domain.com

# Internal staff notification via Meta WhatsApp Cloud API.
# Leave disabled until the business number is registered and a token is set in .env.
# Never commit the real access token.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=v22.0

